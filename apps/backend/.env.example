# =============================================================================
# BACKEND ENVIRONMENT VARIABLES - EXAMPLE
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================================

# ── Azure SQL via Prisma ─────────────────────────────────────────────────────
# Format: sqlserver://<host>:<port>;database=<db>;user=<user>;password=<pass>;encrypt=true;trustServerCertificate=false
DATABASE_URL="sqlserver://your-server.database.windows.net:1433;database=reservas_db;user=your_user@your-server;password=YourStr0ngP@ssword!;encrypt=true;trustServerCertificate=false;loginTimeout=30"

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── JWT (if using auth) ───────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=3600s
